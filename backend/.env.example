# PrivateGPT backend environment variables
# Copy this file to backend/.env and fill in your values.
# Never commit .env to git.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_NAME=privategpt
DB_HOST=localhost
DB_USER=admin
DB_PASSWORD=

# Path to the SQLite database file (used in desktop/local mode)
DB_PATH=./database.db

# ---------------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------------
# OpenAI — required for document embedding (text-embedding-ada-002)
OPENAI_API_KEY=sk-...

# SEC API — required for EDGAR / 10-K filing features
# Get a key at https://sec-api.io
SEC_API_KEY=

# ---------------------------------------------------------------------------
# Stripe — required for payment features
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...

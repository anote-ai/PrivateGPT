# PrivateGPT Backend Environment Variables
# Copy this file to .env and fill in your values
# Never commit the .env file to version control

# Database Configuration (MySQL production)
DB_HOST=your-db-host.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your-db-password
DB_NAME=privategpt

# Only needed by developers running MySQL locally (see database/db.py, database/db_auth.py)
LOCAL_DB_ROOT_PASSWORD=
LOCAL_DB_SOCKET_PASSWORD=

# SEC EDGAR API Key (get from https://sec-api.io)
SEC_API_KEY=your-sec-api-key-here

# OpenAI API Key (optional, for embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# SQLite DB path (for local/desktop builds, leave blank for default ./database.db)
DB_PATH=./database.db

# Local model configuration (Ollama)
# Index into LOCAL_CHAT_MODELS in backend/local_models.py: 0=qwen3:8b, 1=llama3.1:8b, 2=qwen2.5:3b
# Use 2 on machines with 8GB RAM or less.
DEFAULT_LOCAL_CHAT_MODEL_TYPE=0
# Embedding model pulled via `ollama pull`
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Optional: path to the ollama binary if it's not on PATH
OLLAMA_PATH=
# Optional: force a specific GPU layer count (0 = CPU-only). Useful as a
# workaround for the macOS 12/13 Metal crash: ggml-org/llama.cpp#16266
OLLAMA_NUM_GPU=
